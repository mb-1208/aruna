# ==============================================================================
# Aruna Travel Studio - Environment Configuration Template
# Duplicate this file as .env.local for local development.
# NEVER commit .env or .env.local to version control.
# ==============================================================================

# Supabase Public Configuration (Accessible on client and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Private Admin Configuration (Server-side ONLY, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend Transactional Email Engine
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="Aruna Travel Studio <hello@arunatravelstudio.com>"
RESEND_TO_EMAIL="arunatravelstudio@gmail.com"
